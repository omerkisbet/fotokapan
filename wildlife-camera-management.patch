+
+.camera-row:hover {
+    margin-inline: calc(var(--gutter) * -0.18);
+    padding-inline: calc(var(--gutter) * 0.18);
+    background: rgba(255, 255, 255, 0.38);
+}
+
+.camera-row-index,
+.camera-row-code,
+.camera-row-location,
+.camera-status-text {
+    font-size: 11px;
+    font-weight: 750;
+    letter-spacing: 0.12em;
+    text-transform: uppercase;
+}
+
+.camera-row-index {
+    color: var(--copper-dark);
+}
+
+.camera-row-code {
+    display: block;
+    color: var(--ink-soft);
+}
+
+.camera-row-name {
+    margin: 8px 0 0;
+    font-family: var(--font-display);
+    font-size: clamp(25px, 2.4vw, 38px);
+    font-weight: 400;
+    line-height: 1;
+    letter-spacing: -0.035em;
+}
+
+.camera-row-location {
+    color: var(--ink-soft);
+    line-height: 1.6;
+}
+
+.camera-row-status {
+    display: inline-flex;
+    align-items: center;
+    gap: 10px;
+}
+
+.camera-status-dot {
+    width: 9px;
+    height: 9px;
+    border-radius: 50%;
+    background: #818789;
+}
+
+.camera-row[data-status="ONLINE"] .camera-status-dot {
+    background: var(--signal);
+    box-shadow: 0 0 0 5px rgba(36, 135, 92, 0.12);
+}
+
+.camera-row[data-status="MAINTENANCE"] .camera-status-dot {
+    background: var(--copper);
+    box-shadow: 0 0 0 5px rgba(197, 103, 63, 0.12);
+}
+
+.camera-row[data-status="OFFLINE"] .camera-status-dot {
+    background: var(--danger);
+    box-shadow: 0 0 0 5px rgba(169, 56, 46, 0.1);
+}
+
+.camera-row-actions {
+    display: flex;
+    align-items: center;
+    justify-content: flex-end;
+    gap: 18px;
+    white-space: nowrap;
+}
+
+.camera-live-link,
+.camera-archive-link {
+    padding: 10px 0;
+    background: transparent;
+    border: 0;
+    color: var(--ink);
+    cursor: pointer;
+    font-size: 13px;
+    font-weight: 750;
+    text-decoration: none;
+}
+
+.camera-live-link {
+    color: var(--copper-dark);
+}
+
+.camera-live-link:hover,
+.camera-archive-link:hover {
+    text-decoration: underline;
+    text-underline-offset: 4px;
+}
+
+.camera-directory-empty {
+    padding: 42px 0;
+    color: var(--ink-soft);
+    border-bottom: 1px solid var(--line);
+}
+
+@media (max-width: 1080px) {
+    .camera-row {
+        grid-template-columns: 42px minmax(220px, 1fr) minmax(130px, 0.6fr) auto;
+    }
+
+    .camera-row-location {
+        display: none;
+    }
+}
+
+@media (max-width: 760px) {
+    .camera-directory {
+        padding-top: 44px;
+        padding-bottom: 52px;
+    }
+
+    .camera-directory-heading {
+        grid-template-columns: 1fr;
+        gap: 20px;
+    }
+
+    .camera-row {
+        padding: 24px 0;
+        grid-template-columns: 34px minmax(0, 1fr);
+        gap: 12px 18px;
+    }
+
+    .camera-row-status,
+    .camera-row-actions {
+        grid-column: 2;
+        justify-content: flex-start;
+    }
+
+    .camera-row-actions {
+        flex-wrap: wrap;
+    }
+}
